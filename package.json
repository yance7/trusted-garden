{
  "name": "trusted-garden-hd",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node tools/assets/build.mjs && node tools/assets/build-character.mjs",
    "author:materials": "python tools/assets/textures.py && python tools/assets/import-cc0.py",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run assets && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "verify": "node tools/verify-hd.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.64.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
